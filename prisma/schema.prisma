// Prisma schema — Plateforme de gestion Auto-École
// Base de données : PostgreSQL (Supabase / Neon en production)

generator client {
  provider      = "prisma-client-js"
  // "rhel-openssl-3.0.x" : moteur requis par les fonctions serverless (Netlify / AWS Lambda)
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// Administrateur — seul utilisateur ayant accès à la plateforme
model Admin {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("admins")
}

enum LicenseType {
  A
  A1
  B
  C
  D
  BE
  CE
}

enum PaymentStatus {
  PAYE
  PARTIEL
  NON_PAYE
}

/// Client / candidat de l'auto-école (ne se connecte jamais à la plateforme)
model Client {
  id               String      @id @default(cuid())
  publicToken      String      @unique @default(cuid())
  firstName        String
  lastName         String
  phone            String
  whatsapp         String
  cin              String      @unique
  birthDate        DateTime?
  address          String?
  licenseType      LicenseType @default(B)
  registrationDate DateTime    @default(now())
  startDate        DateTime?
  notes            String?
  isActive         Boolean     @default(true)

  // Inscriptions (frais figés au moment de l'inscription)
  registeredCode         Boolean @default(false)
  registeredConduite     Boolean @default(false)
  registeredPark         Boolean @default(false)
  feeInscriptionCode     Float   @default(0)
  feeInscriptionConduite Float   @default(0)
  feeInscriptionPark     Float   @default(0)

  sessions Session[]
  payments Payment[]
  exams    Exam[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("clients")
}

enum SessionStatus {
  PREVUE
  EFFECTUEE
  ANNULEE
  ABSENCE
}

enum SessionType {
  CONDUITE
  PARK
  CODE
  AUTRE
}

model Session {
  id         String        @id @default(cuid())
  clientId   String
  client     Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  date       DateTime
  startTime  String // "15:00"
  endTime    String // "16:00"
  type       SessionType   @default(CONDUITE)
  status     SessionStatus @default(PREVUE)
  /// Tarif horaire appliqué (figé à la création de la séance)
  hourlyRate Float         @default(0)
  notes      String?

  instructorId String?
  instructor   Instructor? @relation(fields: [instructorId], references: [id])

  vehicleId String?
  vehicle   Vehicle? @relation(fields: [vehicleId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("sessions")
}

enum PaymentMethod {
  ESPECES
  VIREMENT
  CHEQUE
  CARTE
  AUTRE
}

/// Compte auquel un paiement client est affecté
enum PaymentCategory {
  INSCRIPTION
  CONDUITE
  CODE
  EXAMEN
}

model Payment {
  id        String          @id @default(cuid())
  clientId  String
  client    Client          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  amount    Float
  date      DateTime        @default(now())
  category  PaymentCategory @default(CONDUITE)
  method    PaymentMethod   @default(ESPECES)
  reference String?
  notes     String?

  createdAt DateTime @default(now())

  @@map("payments")
}

enum ExamType {
  CODE
  PARK
  CONDUITE
}

enum ExamResult {
  PROGRAMME
  REUSSI
  ECHOUE
  ABSENT
}

/// Passage d'examen officiel — un client peut repasser un examen autant de fois que nécessaire
model Exam {
  id       String     @id @default(cuid())
  clientId String
  client   Client     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  type     ExamType
  date     DateTime
  time     String?
  result   ExamResult @default(PROGRAMME)
  /// Frais d'examen facturés au client (0 si inclus)
  fee      Float      @default(0)
  location String?
  notes    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId, type])
  @@map("exams")
}

enum ExpenseCategory {
  CARBURANT
  ENTRETIEN
  ASSURANCE
  SALAIRE
  LOYER
  FACTURES
  FRAIS_EXAMEN
  TAXES
  FOURNITURES
  AUTRE
}

/// Dépense / sortie d'argent de l'auto-école
model Expense {
  id        String          @id @default(cuid())
  label     String
  category  ExpenseCategory @default(AUTRE)
  amount    Float
  date      DateTime        @default(now())
  method    PaymentMethod   @default(ESPECES)
  reference String?
  notes     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([date])
  @@map("expenses")
}

model Vehicle {
  id          String      @id @default(cuid())
  brand       String
  model       String
  plateNumber String      @unique
  licenseType LicenseType @default(B)
  isActive    Boolean     @default(true)
  sessions    Session[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("vehicles")
}

model Instructor {
  id        String    @id @default(cuid())
  firstName String
  lastName  String
  phone     String?
  isActive  Boolean   @default(true)
  sessions  Session[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("instructors")
}

model Settings {
  id         String  @id @default(cuid())
  schoolName String  @default("Auto-École")
  logoUrl    String?
  address    String?
  phone      String?
  whatsapp   String?
  email      String?
  currency   String  @default("TND")

  // Tarifs
  priceHourConduite      Float @default(28)
  priceHourCode          Float @default(10)
  feeInscriptionCode     Float @default(100)
  feeInscriptionConduite Float @default(200)
  feeInscriptionPark     Float @default(200)
  // Frais de repassage d'un examen après un échec ou une absence
  feeRetakeCode          Float @default(50)
  feeRetakePark          Float @default(100)
  feeRetakeConduite      Float @default(100)

  updatedAt DateTime @updatedAt

  @@map("settings")
}
